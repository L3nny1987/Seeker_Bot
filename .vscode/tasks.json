{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Seeker Bot: Build",
      "type": "shell",
      "command": "pio",
      "args": [
        "run",
        "-e",
        "seeker_bot"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "Seeker Bot: USB upload (auto port)",
      "type": "shell",
      "command": "pio",
      "args": [
        "run",
        "-e",
        "seeker_bot",
        "-t",
        "upload"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Seeker Bot: Host tests",
      "type": "shell",
      "command": "python",
      "args": [
        "tools/run_host_tests.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
